  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "ProjectInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description"
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Location"
          },
          "manager_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Manager Id"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "status": {
            "type": "string",
            "enum": [
              "activo",
              "pausado",
              "finalizado"
            ],
            "title": "Status",
            "default": "activo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "description",
          "location",
          "manager_id",
          "start_date",
          "end_date"
        ],
        "title": "ProjectInput"
      },
      "ReportInput": {
        "properties": {
          "work_date": {
            "type": "string",
            "format": "date",
            "title": "Work Date"
          },
          "progress": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 5,
            "title": "Progress"
          },
          "incidents": {
            "type": "string",
            "maxLength": 5000,
            "title": "Incidents",
            "default": ""
          },
          "observations": {
            "type": "string",
            "maxLength": 5000,
            "title": "Observations",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "work_date",
          "progress"
        ],
        "title": "ReportInput"
      },
      "StatusInput": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pendiente",
              "en_proceso",
              "completada"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusInput"
      },
      "TaskInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Title"
          },
          "assignee_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Assignee Id"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "title": "Due Date"
          },
          "priority": {
            "type": "string",
            "enum": [
              "baja",
              "media",
              "alta"
            ],
            "title": "Priority",
            "default": "media"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "assignee_id",
          "due_date"
        ],
        "title": "TaskInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
